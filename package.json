{
  "name": "windbot-arena",
  "version": "1.0.0",
  "description": "WindBot 对战实验的 Web 控制台与持久化统计服务。",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "naive-ui": "^2.42.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
